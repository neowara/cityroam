<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Explicit-intent target for BoardWakeScan's PendingIntent-based scan — receives
         a scan result even after the app's process has been killed outright. Not
         exported: the system delivers to it directly, on this app's own behalf. -->
    <receiver
      android:name=".BoardWakeScanReceiver"
      android:exported="false" />
  </application>
</manifest>
