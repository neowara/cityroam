{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../src/*"],
      "@modules/*": ["../modules/*"]
    }
  },
  "include": ["src/**/*", "../src/components/**/*", "../src/lib/theme.tsx", "../src/constants/**/*", "../modules/**/*.d.ts"]
}
